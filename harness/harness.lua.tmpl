-- sc64 emulator harness -- BizHawk (EmuHawk) side.
-- Loaded via `EmuHawk.exe <rom> --lua=<this file>`.
-- Talks to Python over single-writer files in DIR (no sockets, no ports).
--
-- Protocol
--   Python writes  DIR/req_<seq>.tmp   then renames to  DIR/req_<seq>.txt
--   Lua    writes  DIR/resp_<seq>.tmp  then renames to  DIR/resp_<seq>.txt
--   Because every filename carries a fresh seq, the rename target never
--   pre-exists, so os.rename works on Windows and neither side can read a
--   half-written file.
-- Request body : CMD \n arg1 \n arg2 ...
-- Response body: OK \n payload      |  ERR \n message

local DIR = [[@@DIR@@]]
local NL = string.char(10)
local TAB = string.char(9)

local seq = 1                 -- next request number we expect
local target_frame = nil      -- set by FRAMES; loop runs until reached
local pending_seq = nil       -- response owed once target_frame is hit
local hold_until = nil        -- set by HOLD
local hold_btns = nil
local hold_pad = 1

local function path(name) return DIR .. [[\]] .. name end

local function write_file(name, body)
    local tmp = path(name .. ".tmp")
    local fh = io.open(tmp, "wb")
    if not fh then return false end
    fh:write(body)
    fh:close()
    os.rename(tmp, path(name .. ".txt"))
    return true
end

local function read_consume(name)
    local p = path(name .. ".txt")
    local fh = io.open(p, "rb")
    if not fh then return nil end
    local body = fh:read("*a")
    fh:close()
    os.remove(p)
    return body
end

local function reply(s, ok, payload)
    write_file("resp_" .. s, (ok and "OK\n" or "ERR\n") .. (payload or ""))
end

-- ---------------------------------------------------------------- helpers

local HEX = "0123456789abcdef"
local function tohex(b)
    return HEX:sub(math.floor(b / 16) + 1, math.floor(b / 16) + 1)
        .. HEX:sub(b % 16 + 1, b % 16 + 1)
end

-- Accept either a raw RDRAM offset or a 0x80xxxxxx KSEG0 virtual address.
-- Returns (address, domain) for the requested domain name.
local function resolve(addr, domain)
    domain = domain or "RDRAM"
    if domain == "RDRAM" and addr >= 0x80000000 then
        addr = addr - 0x80000000
    end
    return addr, domain
end

local function safe_reg(name)
    local ok, v = pcall(function() return emu.getregister(name) end)
    if ok and v ~= nil then return v end
    return nil
end

-- Best-effort program counter. Ares64 exposes "PC"; other cores differ, so
-- probe a few spellings once and remember which one answered.
local PC_NAME = nil
local function get_pc()
    if PC_NAME == nil then
        for _, n in ipairs({ "PC", "pc", "R_PC", "CPU PC" }) do
            if safe_reg(n) ~= nil then PC_NAME = n break end
        end
        if PC_NAME == nil then PC_NAME = false end
    end
    if PC_NAME == false then return nil end
    local v = safe_reg(PC_NAME)
    if v == nil then return nil end
    -- MIPS III PC is 64-bit and comes back signed; fold to the 32-bit
    -- KSEG0 address the community notes are written in.
    return math.floor(v) % 0x100000000
end

-- ---------------------------------------------------------------- commands

local handlers = {}

handlers.PING = function() return true, "pong" end

handlers.INFO = function()
    local lines = {}
    local function add(k, v) lines[#lines + 1] = k .. "=" .. tostring(v) end
    add("bizhawk", client.getversion())
    add("system", emu.getsystemid())
    -- BizHawk 2.11 Lua has no "which core" call. Ares64 is a waterbox core
    -- and is the only N64 core that publishes a "Waterbox PageData" domain,
    -- so that domain's presence identifies it.
    local waterbox = false
    local dl = memory.getmemorydomainlist()
    for i = 0, #dl do
        if dl[i] and dl[i]:find("Waterbox") then waterbox = true end
    end
    add("core_guess", waterbox and "Ares64" or "Mupen64Plus")
    add("region", emu.getdisplaytype())
    add("romhash", gameinfo.getromhash())
    add("romname", gameinfo.getromname())
    add("frame", emu.framecount())
    add("lag", emu.lagcount())
    add("pcname", tostring(PC_NAME))
    return true, table.concat(lines, "\n")
end

handlers.DOMAINS = function()
    local list = memory.getmemorydomainlist()
    local out = {}
    for i = 0, #list do
        local n = list[i]
        if n then
            out[#out + 1] = n .. "\t" .. tostring(memory.getmemorydomainsize(n))
        end
    end
    return true, table.concat(out, "\n")
end

handlers.REGS = function()
    local ok, regs = pcall(function() return emu.getregisters() end)
    if not ok or regs == nil then return false, "core exposes no registers" end
    local out = {}
    for k, v in pairs(regs) do out[#out + 1] = tostring(k) .. "=" .. tostring(v) end
    table.sort(out)
    return true, table.concat(out, "\n")
end

handlers.BTNS = function()
    local out = {}
    for k, v in pairs(joypad.get(1)) do out[#out + 1] = tostring(k) end
    table.sort(out)
    return true, table.concat(out, "\n")
end

handlers.READ = function(a)
    local addr = tonumber(a[1])
    local size = tonumber(a[2])
    local dom = a[3]
    if not addr or not size then return false, "READ addr size [domain]" end
    if size < 1 or size > 65536 then return false, "size out of range" end
    local ad, dm = resolve(addr, dom)
    local parts = {}
    for i = 0, size - 1 do
        parts[#parts + 1] = tohex(memory.read_u8(ad + i, dm))
    end
    return true, table.concat(parts)
end

handlers.WRITE = function(a)
    local addr = tonumber(a[1])
    local hex = a[2] or ""
    local dom = a[3]
    if not addr or #hex % 2 ~= 0 then return false, "WRITE addr hex [domain]" end
    local ad, dm = resolve(addr, dom)
    local n = #hex // 2          -- integer div: `/` yields a float in Lua 5.4
    for i = 0, n - 1 do
        local byte = tonumber(hex:sub(i * 2 + 1, i * 2 + 2), 16)
        if byte == nil then return false, "bad hex at byte " .. i end
        memory.write_u8(ad + i, byte, dm)
    end
    return true, tostring(n)
end

handlers.SHOT = function(a)
    if not a[1] then return false, "SHOT path" end
    client.screenshot(a[1])
    return true, a[1]
end

handlers.STATUS = function()
    local pc = get_pc()
    local lines = {
        "frame=" .. emu.framecount(),
        "lag=" .. emu.lagcount(),
        "pc=" .. (pc and string.format("0x%08X", pc) or "unavailable"),
    }
    return true, table.concat(lines, "\n")
end

handlers.SPEED = function(a)
    local pct = tonumber(a[1])
    if not pct then return false, "SPEED percent" end
    client.speedmode(pct)
    return true, tostring(pct)
end

-- Not available in BizHawk 2.11.1 (verified: client.invisibleemulation is nil).
-- Kept so the failure is explicit rather than a stack trace.
handlers.INVISIBLE = function(a)
    if type(client.invisibleemulation) ~= "function" then
        return false, "client.invisibleemulation not present in this BizHawk"
    end
    client.invisibleemulation(a[1] == "1")
    return true, a[1] or "0"
end

handlers.API = function(a)
    local t = ({ client = client, emu = emu, memory = memory,
                 joypad = joypad, savestate = savestate, gameinfo = gameinfo })[a[1]]
    if not t then return false, "API client|emu|memory|joypad|savestate|gameinfo" end
    local out = {}
    for k, v in pairs(t) do out[#out + 1] = tostring(k) .. " (" .. type(v) .. ")" end
    table.sort(out)
    return true, table.concat(out, "\n")
end

handlers.CAPS = function()
    local NL = string.char(10)
    local out = {}
    local function add(k, v) out[#out + 1] = k .. "=" .. tostring(v) end

    -- Report the type but never BRANCH on it. NLua exposes .NET methods as
    -- userdata, so testing for "function" here silently disables the probe.
    for _, n in ipairs({ "onmemoryread", "onmemorywrite", "onmemoryexecute",
                         "onframestart", "onframeend", "unregisterbyid",
                         "availableScopes" }) do
        local ok, v = pcall(function() return event[n] end)
        add("event." .. n, ok and type(v) or "absent")
    end

    -- Which scope strings does THIS core accept? A callback registered
    -- against a scope the core does not publish is silently inert rather
    -- than an error, which is the worst failure mode for an instrument.
    local ok, sc = pcall(function() return event.availableScopes() end)
    if ok and type(sc) == "table" then
        local names = {}
        for _, v in pairs(sc) do names[#names + 1] = tostring(v) end
        table.sort(names)
        add("scopes", table.concat(names, ","))
    else
        add("scopes", "unavailable: " .. tostring(sc))
    end

    -- Registering is not the same as firing. Hook reads, run frames, count.
    local hits = 0
    local id = nil
    local rok, rid = pcall(function()
        return event.onmemoryread(function() hits = hits + 1 end,
                                  nil, "capsprobe", "System Bus")
    end)
    add("register_systembus", rok and ("ok id=" .. tostring(rid))
                                  or ("failed: " .. tostring(rid)))
    if rok then id = rid end
    for _ = 1, 3 do emu.frameadvance() end
    add("read_hits_3_frames", hits)
    if id then pcall(function() event.unregisterbyid(id) end) end

    -- Same again with no scope argument, in case the default scope is the
    -- one that works on this core.
    local hits2 = 0
    local rok2, rid2 = pcall(function()
        return event.onmemoryread(function() hits2 = hits2 + 1 end,
                                  nil, "capsprobe2")
    end)
    add("register_default", rok2 and ("ok id=" .. tostring(rid2))
                                 or ("failed: " .. tostring(rid2)))
    for _ = 1, 3 do emu.frameadvance() end
    add("read_hits_default", hits2)
    if rok2 then pcall(function() event.unregisterbyid(rid2) end) end

    -- And an execute hook, which is what a real breakpoint needs.
    local xhits = 0
    local xok, xid = pcall(function()
        return event.onmemoryexecute(function() xhits = xhits + 1 end,
                                     nil, "capsprobe3")
    end)
    add("register_exec", xok and ("ok id=" .. tostring(xid))
                             or ("failed: " .. tostring(xid)))
    for _ = 1, 3 do emu.frameadvance() end
    add("exec_hits", xhits)
    if xok then pcall(function() event.unregisterbyid(xid) end) end

    return true, table.concat(out, NL)
end

-- ------------------------------------------------------------ watchpoints
--
-- Registered hooks, and hits aggregated as key -> pc -> {n, first, last}.
-- Aggregating in Lua rather than shipping every hit to Python keeps a watch on
-- a hot address from turning into a hundred megabytes of duplicate lines.
local watch_ids = {}
local snaps = {}
local watch_log = {}
local watch_hits = 0
local WATCH_MAX = 2000000        -- stop recording, keep counting, past this

-- Anchor for the overlay signature. nil means "not configured", and every
-- row then reports "-" rather than a fake identity.
local sig_addr = nil
local sig_words = 8

local function overlay_sig()
    if not sig_addr then return nil end
    local base = sig_addr
    if base >= 0x80000000 then base = base - 0x80000000 end
    local ok, acc = pcall(function()
        local h = 0
        for i = 0, sig_words - 1 do
            local w = memory.read_u32_be(base + i * 4, "RDRAM")
            h = (h * 31 + w) % 4294967296
        end
        return h
    end)
    if ok then return acc end
    return false                      -- distinct from any real signature
end

local function sig_label(sig)
    if sig == nil then return "-" end
    if sig == false then return "ERR" end
    return string.format("%08X", sig)
end

local function watch_record(key, pc, frame)
    watch_hits = watch_hits + 1
    if watch_hits > WATCH_MAX then return end
    local t = watch_log[key]
    if not t then t = {} watch_log[key] = t end
    -- Aggregate by (pc, overlay), not pc: the same address under two
    -- different resident images is two different functions.
    local sig = sig_label(overlay_sig())
    local slot = string.format("%08X:%s", pc % 0x100000000, sig)
    local e = t[slot]
    if e then
        e.n = e.n + 1
        e.last = frame
    else
        t[slot] = { pc = pc, sig = sig, n = 1, first = frame, last = frame }
    end
end

-- A core with no callback support ACCEPTS the registration and hands back an
-- all-zero GUID, then never fires. That is the single most dangerous failure
-- mode here -- it looks exactly like "nothing touched this address" -- so it
-- is turned into a hard error at registration time.
local function is_null_id(id)
    local s = tostring(id):gsub("[-0]", "")
    return s == ""
end

local call_log = {}
local call_ids = {}
local CALL_MAX = 4096

handlers.CALLLOG = function(a)
    local addr = tonumber(a[1])
    local reg = a[2] or "a0"
    if not addr then return false, "CALLLOG addr [reg]" end
    local key = string.format("%08X:%s", addr, reg)
    call_log[key] = {}
    local t = call_log[key]
    local n = 0
    local fn = function()
        n = n + 1
        if n > CALL_MAX then return end
        -- Mupen64Plus splits each 64-bit GPR into <name>_hi / <name>_lo.
        local v = safe_reg(reg .. "_lo")
        if v == nil then v = safe_reg(reg) end
        if v == nil then v = -1 end
        v = math.floor(v) % 0x100000000
        local f = emu.framecount()
        local e = t[v]
        if e then
            e.n = e.n + 1
            e.last = f
        else
            t[v] = { n = 1, first = f, last = f }
        end
    end
    local ok, id = pcall(function()
        return event.onmemoryexecute(fn, addr, key, "System Bus")
    end)
    if not ok then return false, "register failed: " .. tostring(id) end
    if is_null_id(id) then
        return false, "core returned a null hook id -- this core does not "
            .. "implement memory callbacks; boot with core=Mupen64Plus"
    end
    call_ids[#call_ids + 1] = id
    return true, key .. " id=" .. tostring(id)
end

handlers.CALLLOGDUMP = function(a)
    local top = tonumber(a[1]) or 400
    local out = {}
    for key, t in pairs(call_log) do
        local rows = {}
        for v, e in pairs(t) do
            rows[#rows + 1] = { v = v, n = e.n, first = e.first, last = e.last }
        end
        -- by first sighting, so the dump reads as the load order
        table.sort(rows, function(x, y) return x.first < y.first end)
        out[#out + 1] = "log=" .. key .. " distinct=" .. #rows
        for i = 1, math.min(#rows, top) do
            local r = rows[i]
            out[#out + 1] = "  " .. string.format("0x%08X", r.v)
                .. TAB .. r.n .. TAB .. r.first .. TAB .. r.last
        end
    end
    if #out == 0 then out[#out + 1] = "log= none" end
    return true, table.concat(out, NL)
end

handlers.WATCH = function(a)
    local addr = tonumber(a[1])
    local kind = (a[2] or "read"):lower()
    local scope = a[3] or "System Bus"
    local snap_addr = tonumber(a[4])
    local snap_len = tonumber(a[5]) or 256
    if not addr then
        return false, "WATCH addr [read|write|exec] [scope] [snap_addr] [snap_len]"
    end
    local reg = ({ read = event.onmemoryread,
                   write = event.onmemorywrite,
                   exec = event.onmemoryexecute })[kind]
    if not reg then return false, "kind must be read, write or exec" end

    local key = kind .. ":" .. string.format("0x%08X", addr)
    local fn = function()
        watch_record(key, get_pc() or -1, emu.framecount())
        -- Photograph memory the first time only. Overlay code is resident
        -- only while it runs, so a later read gets whatever replaced it.
        if not snaps[key] then
            -- ra is the whole point: at an execute breakpoint it names the
            -- caller outright, which no amount of static scanning has managed.
            local regs = {}
            for _, rn in ipairs({ "ra", "a0", "a1", "a2", "a3",
                                  "v0", "v1", "s0", "s1", "sp" }) do
                -- Mupen64Plus splits each 64-bit GPR into
                -- <name>_hi / <name>_lo; Ares64 uses the bare name.
                local rv = safe_reg(rn .. "_lo")
                if rv == nil then rv = safe_reg(rn) end
                if rv ~= nil then
                    regs[#regs + 1] = rn .. "="
                        .. string.format("0x%08X", math.floor(rv) % 0x100000000)
                end
            end
            snaps[key] = { frame = emu.framecount(), pc = get_pc() or -1,
                           addr = snap_addr or 0, hex = "",
                           regs = table.concat(regs, ",") }
        end
        if snap_addr and snaps[key] and snaps[key].hex == "" then
            local base = snap_addr
            if base >= 0x80000000 then base = base - 0x80000000 end
            -- Reading memory inside a memory callback can be refused or
            -- can re-enter, so this must never fail quietly: an empty
            -- snapshot would look like an address holding nothing,
            -- rather than one that was never captured -- the exact
            -- silent failure this tool exists to avoid.
            local ok, res = pcall(function()
                local parts = {}
                for i = 0, snap_len - 1 do
                    parts[#parts + 1] = tohex(memory.read_u8(base + i, "RDRAM"))
                end
                return table.concat(parts)
            end)
            if ok then
                snaps[key].hex = res
            else
                snaps[key].err = tostring(res)
            end
        end
    end
    local ok, id = pcall(function() return reg(fn, addr, key, scope) end)
    if not ok then return false, "register failed: " .. tostring(id) end
    if is_null_id(id) then
        return false, "core returned a null hook id -- this core does not "
            .. "implement memory callbacks; boot with core=Mupen64Plus"
    end
    watch_ids[#watch_ids + 1] = id
    return true, key .. " id=" .. tostring(id)
end

handlers.WATCHDUMP = function(a)
    local top = tonumber(a[1]) or 64
    local out = {}
    out[#out + 1] = "total_hits=" .. watch_hits
    out[#out + 1] = "truncated=" .. tostring(watch_hits > WATCH_MAX)
    for key, t in pairs(watch_log) do
        local rows = {}
        for _, e in pairs(t) do rows[#rows + 1] = e end
        table.sort(rows, function(x, y) return x.n > y.n end)
        out[#out + 1] = "watch=" .. key .. " distinct_sites=" .. #rows
        for i = 1, math.min(#rows, top) do
            local r = rows[i]
            out[#out + 1] = "  " .. string.format("0x%08X", r.pc)
                .. TAB .. r.sig .. TAB .. r.n .. TAB .. r.first .. TAB .. r.last
        end
    end
    return true, table.concat(out, NL)
end

handlers.SNAPDUMP = function()
    local out = {}
    for key, s in pairs(snaps) do
        out[#out + 1] = key .. TAB .. s.frame .. TAB
            .. string.format("0x%08X", s.pc) .. TAB
            .. string.format("0x%08X", s.addr) .. TAB
            .. (s.regs or "") .. TAB
            .. ((s.hex ~= "") and s.hex or ("ERR:" .. (s.err or "not captured")))
    end
    if #out == 0 then out[#out + 1] = "none" end
    return true, table.concat(out, NL)
end

handlers.SIGSET = function(a)
    local addr = tonumber(a[1])
    if not addr then return false, "SIGSET addr [words]" end
    sig_addr = addr
    sig_words = tonumber(a[2]) or 8
    local s = overlay_sig()
    if s == false then
        return false, "cannot read " .. string.format("0x%08X", addr)
    end
    return true, sig_label(s)
end

handlers.SIGCLEAR = function()
    sig_addr = nil
    return true, "off"
end

handlers.SIG = function()
    return true, sig_label(overlay_sig())
end

handlers.WATCHCLEAR = function()
    local n = #watch_ids
    for _, id in ipairs(watch_ids) do
        pcall(function() event.unregisterbyid(id) end)
    end
    watch_ids = {}
    watch_log = {}
    snaps = {}
    watch_hits = 0
    return true, tostring(n)
end

-- ------------------------------------------------------------ pc trace

local trace_left = 0
local trace_log = {}
local trace_samples = 0

handlers.TRACE = function(a, s)
    local n = tonumber(a[1]) or 60
    trace_log = {}
    trace_samples = 0
    trace_left = n
    target_frame = emu.framecount() + n
    pending_seq = s
    return nil                      -- replies when the frames have run
end

handlers.TRACEDUMP = function(a)
    local top = tonumber(a[1]) or 40
    local rows = {}
    for pc, n in pairs(trace_log) do rows[#rows + 1] = { pc = pc, n = n } end
    table.sort(rows, function(x, y) return x.n > y.n end)
    local out = { "samples=" .. trace_samples, "distinct_pcs=" .. #rows }
    for i = 1, math.min(#rows, top) do
        out[#out + 1] = "  " .. string.format("0x%08X", rows[i].pc)
            .. TAB .. rows[i].n
    end
    return true, table.concat(out, NL)
end

handlers.SAVESTATE = function(a)
    if not a[1] then return false, "SAVESTATE path" end
    savestate.save(a[1])
    return true, a[1]
end

handlers.LOADSTATE = function(a)
    if not a[1] then return false, "LOADSTATE path" end
    savestate.load(a[1])
    return true, a[1]
end

handlers.QUIT = function()
    write_file("resp_" .. seq, "OK\nbye")
    client.exit()
    return nil
end

-- FRAMES and HOLD are deferred: they reply only once the frames have elapsed.
handlers.FRAMES = function(a, s)
    local n = tonumber(a[1]) or 1
    target_frame = emu.framecount() + n
    pending_seq = s
    return nil                     -- reply later
end

handlers.HOLD = function(a, s)
    local n = tonumber(a[1]) or 1
    hold_btns = {}
    for btn in (a[2] or ""):gmatch("[^,]+") do hold_btns[btn] = true end
    hold_pad = tonumber(a[3]) or 1
    hold_until = emu.framecount() + n
    target_frame = hold_until
    pending_seq = s
    return nil
end

-- ---------------------------------------------------------------- main loop

local function poll()
    if pending_seq then return end          -- busy running frames
    local body = read_consume("req_" .. seq)
    if not body then return end
    local args = {}
    for line in (body .. "\n"):gmatch("([^\n]*)\n") do
        args[#args + 1] = (line:gsub("\r$", ""))
    end
    local cmd = table.remove(args, 1)
    local h = handlers[cmd]
    local s = seq
    seq = seq + 1
    if not h then reply(s, false, "unknown command: " .. tostring(cmd)) return end
    local ok, a, b = pcall(h, args, s)
    if not ok then
        reply(s, false, tostring(a))
    elseif a ~= nil then
        reply(s, a, b)
    end                                      -- a == nil => deferred
end

write_file("ready", "1")
console.log("sc64 harness up; DIR=" .. DIR)

local hb = 0
while true do
    poll()

    if hold_until and emu.framecount() < hold_until and hold_btns then
        joypad.set(hold_btns, hold_pad)
    end

    if target_frame and emu.framecount() >= target_frame then
        local s = pending_seq
        target_frame, pending_seq, hold_until, hold_btns = nil, nil, nil, nil
        if s then reply(s, true, tostring(emu.framecount())) end
    end

    if trace_left > 0 then
        local p = get_pc() or -1
        trace_log[p] = (trace_log[p] or 0) + 1
        trace_samples = trace_samples + 1
        trace_left = trace_left - 1
    end

    hb = hb + 1
    if hb >= 5 then
        hb = 0
        local pc = get_pc()
        local fh = io.open(path("hb.txt"), "wb")
        if fh then
            fh:write(emu.framecount() .. "\n" .. (pc or -1) .. "\n" .. os.time())
            fh:close()
        end
    end

    emu.frameadvance()
end
